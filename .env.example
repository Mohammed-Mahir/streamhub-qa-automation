# Copy to .env and adjust. No URLs are hardcoded in code - everything comes from here.
BASE_URL=https://emicalculator.net
API_BASE_URL=http://localhost:3001
START_MOCK_API=true
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
TIMEOUT_MS=15000
EMI_TOLERANCE=1
# Only needed for the self-healing POC (npm run heal)
ANTHROPIC_API_KEY=
HEAL_MODEL=claude-sonnet-5-5
